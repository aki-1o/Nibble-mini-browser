{
  "name": "nibble",
  "version": "1.0.0",
  "description": "Nibble — a tiny Electron browser with a built-in API console, for AA consent-journey testing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aa.minibrowser",
    "productName": "Nibble",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "page-preload.js",
      "index.html",
      "renderer.js",
      "api-panel.js",
      "package.json",
      "assets/**"
    ],
    "win": {
      "icon": "assets/favicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nibble"
    }
  }
}
